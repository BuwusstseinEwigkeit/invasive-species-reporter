PORT=3000
SERVER_PUBLIC_BASE_URL=http://YOUR_LAN_IP:3000

# Zhipu (primary recognition provider)
# Get your API key from: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4.6v-flash
ZHIPU_MAX_RETRIES=3

# Moonshot/Kimi vision API (optional fallback when Zhipu fails)
# MOONSHOT_API_KEY=your_moonshot_api_key_here
# MOONSHOT_MODEL=moonshot-v1-8k-vision-preview

# Python Docker microservice (optional, set URL to enable)
# PYTHON_RECOGNITION_URL=http://localhost:5100

# Ollama local vision model (qwen2.5vl installed locally)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_VISION_MODEL=

# WeChat login (optional — for real device testing)
# Get from: https://developers.weixin.qq.com/app
WECHAT_APPID=
WECHAT_SECRET=

# JWT secret — MUST be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_STRONG_RANDOM_SECRET_HERE_AT_LEAST_32_CHARS

# Seed accounts (only created on first startup if not existing)
# ⚠️ Set strong passwords! Accounts won't be created if password is empty.
ADMIN_USER=admin
ADMIN_PASS=your_admin_password_here
REVIEWER_USER=reviewer
REVIEWER_PASS=your_reviewer_password_here
DEMO_USER=demo
DEMO_PASS=your_demo_password_here

# Database
DATABASE_PATH=server/data/invasive-species.db

# CORS origins — comma-separated list of allowed origins, or "*" for any origin
# ⚠️ For production, replace "*" with specific domains like: https://yourdomain.com,https://admin.yourdomain.com
# Example: ALLOWED_ORIGINS=https://example.com,https://admin.example.com
ALLOWED_ORIGINS=*
