.section-card { margin-bottom: 24rpx; }
.record-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:20rpx 0; border-bottom:1rpx solid rgba(31,42,31,.08); }
.record-main { display:flex; flex-direction:column; gap:8rpx; min-width:0; }
.record-title { font-weight:700; }
.record-tag { flex-shrink:0; background:#e7efe5; color:#305d3c; padding:8rpx 14rpx; border-radius:999rpx; font-size:24rpx; }
.order-card { padding:8rpx 0 20rpx; }
.compact { padding:24rpx 0; }
.admin-order { border-bottom: 1rpx solid rgba(31,42,31,.1); }
.admin-actions { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:16rpx; }
.admin-actions button { margin:0; }
