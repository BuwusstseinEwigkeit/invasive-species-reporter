<view class="page-shell">
  <!-- 上报成功全屏插画 -->
  <view class="success-overlay" wx:if="{{submitSuccess}}">
    <image class="success-img" src="/images/report-success.png" mode="aspectFit" />
    <text class="success-title">提交成功</text>
    <text class="success-desc">感谢您的生态线索，审核员将在24小时内完成审核。</text>
    <button class="primary-button success-btn" hover-class="hover-scale" bindtap="goHome">返回首页</button>
  </view>

  <!-- 正常表单 -->
  <view class="card form-card" wx:else>
    <text class="section-title">创建疑似线索</text>

    <view class="field">
      <text class="field-label">现场图片</text>
      <button class="ghost-button" hover-class="hover-scale" bindtap="chooseImage">选择并上传图片</button>
      <image wx:if="{{localImageUrl}}" class="preview-image" src="{{localImageUrl}}" mode="aspectFill" lazy-load />
      <view class="status-bar uploading-bar" wx:if="{{isUploading}}">
        <view class="spinner"></view>
        <text>图片上传中...</text>
      </view>
      <view class="status-bar success-bar" wx:if="{{uploadedImageUrl && !isUploading && !isRecognizing}}">
        <text>图片已上传</text>
      </view>
      <view class="status-bar processing-bar" wx:if="{{isRecognizing}}">
        <view class="spinner"></view>
        <text>AI 识别中，你可以继续填写...</text>
      </view>
    </view>

    <view class="field">
      <text class="field-label">发现位置</text>
      <view class="location-row">
        <button class="ghost-button location-btn" hover-class="hover-scale" bindtap="useCurrentLocation">使用当前位置</button>
        <button class="ghost-button location-btn" hover-class="hover-scale" bindtap="chooseLocation">手动选择</button>
      </view>
      <text class="muted" wx:if="{{address}}">{{address}}</text>
      <text class="muted" wx:if="{{latitude && !address}}">坐标：{{latitude}}, {{longitude}}</text>
    </view>

    <view class="field ai-card">
      <view class="ai-header" hover-class="hover-tap" bindtap="toggleCandidates">
        <text class="field-label">参考结果</text>
        <view class="arrow {{candidatesCollapsed ? '' : 'arrow-down'}}"></view>
      </view>
      <text class="ai-name">{{aiTop1}}</text>
      <text class="muted" wx:if="{{isRecognizing}}">识别中，请稍候...</text>
      <text class="muted" wx:if="{{aiScore}}">置信度：{{aiScore}}</text>
      <text class="muted" wx:if="{{aiSummary}}">{{aiSummary}}</text>
      <view class="collapse-body {{candidatesCollapsed ? 'hidden' : ''}}">
        <view class="candidate-list" wx:if="{{aiCandidates.length}}">
          <view class="candidate-row" wx:for="{{aiCandidates}}" wx:key="speciesId">
            <text class="muted">{{item.speciesName}}</text>
            <text class="muted">{{item.confidence}}</text>
          </view>
        </view>
      </view>
      <button
        wx:if="{{uploadedFileId && !isRecognizing}}"
        class="ghost-button retry-button"
        hover-class="hover-scale"
        bindtap="retryRecognition"
      >
        重新匹配
      </button>
    </view>

    <view class="field">
      <text class="field-label">确认或修正物种</text>
      <input
        class="search-input"
        placeholder="搜索物种中文名、学名或分类"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
      <picker range="{{filteredSpeciesNames}}" value="0" bindchange="onSpeciesChange">
        <view class="picker-box" hover-class="hover-tap">
          {{selectedSpeciesIndex > 0 ? speciesNames[selectedSpeciesIndex] : "暂不选择"}}
        </view>
      </picker>
      <text class="muted">如果参考结果不确定，可在提交前手动修正。</text>
    </view>

    <view class="field">
      <text class="field-label">补充说明</text>
      <textarea
        class="remark-box"
        maxlength="200"
        placeholder="例如数量、周边环境、是否成片扩散"
        bindinput="onRemarkInput"
      />
    </view>

    <button class="primary-button submit-button" hover-class="hover-scale" bindtap="submitReport">提交审核</button>
  </view>
</view>
