.cover-image,
.cover-fallback {
  width: 100%;
  height: 420rpx;
}

.cover-image {
  display: block;
}

.cover-fallback {
  background: linear-gradient(145deg, #355e3b, #9db37f);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-text {
  color: #ffffff;
  font-size: 72rpx;
  font-weight: 700;
}

.detail-card {
  margin-top: -48rpx;
  position: relative;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
}

.latin {
  display: block;
  margin-top: 8rpx;
  color: #546454;
}

.meta {
  display: block;
  margin-top: 12rpx;
  color: #305d3c;
}

.accordion-block {
  border-bottom: 1rpx solid #ece8da;
}

.accordion-block:last-child {
  border-bottom: 0;
}

.accordion-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  cursor: pointer;
  user-select: none;
}

.accordion-header .block-title {
  margin-bottom: 0;
}

.accordion-body {
  overflow: hidden;
  transition: max-height 0.25s ease, opacity 0.2s ease;
  max-height: 2000rpx;
  opacity: 1;
  padding-bottom: 20rpx;
}

.accordion-body.hidden {
  max-height: 0;
  opacity: 0;
  padding-top: 0;
  padding-bottom: 0;
}

.block-title {
  font-size: 28rpx;
  font-weight: 700;
}

.history-card {
  margin-top: 24rpx;
}

.history-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ece8da;
}

.history-main {
  flex: 1;
  padding-right: 20rpx;
}

.history-address {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.status-tag {
  background: #eef4eb;
  color: #305d3c;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}
