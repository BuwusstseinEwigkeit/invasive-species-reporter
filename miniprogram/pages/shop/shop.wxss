.shop-header {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.shop-banner-img {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  display: block;
}

.points-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  background: #eef4eb;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  align-self: flex-start;
}

.points-badge-label {
  font-size: 26rpx;
  color: #6b786b;
}

.points-badge-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #305d3c;
}

.shop-header .ghost-button {
  margin-top: 16rpx;
}

/* --- Product grid --- */

.product-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  background: #fffdf7;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(52, 76, 52, 0.06);
}

.product-image {
  height: 200rpx;
  background: linear-gradient(145deg, #eef4eb, #d4dfce);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-img-placeholder {
  font-size: 60rpx;
  font-weight: 700;
  color: #305d3c;
  opacity: 0.5;
}

.product-body {
  padding: 24rpx;
}

.product-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.product-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #305d3c;
}

.buy-btn {
  font-size: 26rpx;
  padding: 0 24rpx;
  line-height: 2.2;
}

.disabled-btn {
  opacity: 0.5;
}

/* --- Category layout --- */

.category-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.category-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.category-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #305d3c;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* --- Product tag --- */

.product-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.tag-digital {
  background: #eef4eb;
  color: #305d3c;
}

.tag-physical {
  background: #fef3c7;
  color: #92400e;
}

.product-image {
  position: relative;
}

/* --- Shipping modal --- */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.modal-box {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fffdf7;
  border-radius: 28rpx;
  z-index: 101;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #305d3c;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.modal-body {
  padding: 24rpx 32rpx;
}

.shipping-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.modal-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-top: 8rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 32rpx;
}

.modal-footer .ghost-button,
.modal-footer .primary-button {
  flex: 1;
}
