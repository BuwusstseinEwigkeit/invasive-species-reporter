.shop-header {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.shop-banner-img {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  display: block;
}

.points-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  background: #eef4eb;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  align-self: flex-start;
}

.points-badge-label {
  font-size: 26rpx;
  color: #6b786b;
}

.points-badge-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #305d3c;
}

.shop-header .ghost-button {
  margin-top: 16rpx;
}

/* --- Product grid --- */

.product-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  background: #fffdf7;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(52, 76, 52, 0.06);
}

.product-image {
  height: 200rpx;
  background: linear-gradient(145deg, #eef4eb, #d4dfce);
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-img-placeholder {
  font-size: 60rpx;
  font-weight: 700;
  color: #305d3c;
  opacity: 0.5;
}

.product-body {
  padding: 24rpx;
}

.product-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.product-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #305d3c;
}

.buy-btn {
  font-size: 26rpx;
  padding: 0 24rpx;
  line-height: 2.2;
}

.disabled-btn {
  opacity: 0.5;
}
