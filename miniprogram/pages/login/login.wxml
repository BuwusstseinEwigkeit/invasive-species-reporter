<view class="page-shell login-shell">
  <view class="card login-card">
    <text class="login-brand">外来物种哨点</text>
    <text class="login-subtitle">公众参与式监测平台</text>

    <view class="field">
      <text class="field-label">用户名</text>
      <input
        class="login-input"
        placeholder="输入用户名（至少3位）"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="login-input"
        type="safe-password"
        password="{{true}}"
        placeholder="输入密码（至少4位）"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <view class="login-actions">
      <button class="primary-button" hover-class="hover-scale" bindtap="onLogin" disabled="{{submitting}}">
        {{submitting ? "登录中..." : "登录"}}
      </button>
      <button class="ghost-button" hover-class="hover-scale" bindtap="onRegister" disabled="{{submitting}}">
        {{submitting ? "注册中..." : "注册新账号"}}
      </button>
    </view>

    <text class="muted login-hint">注册新账号后即可提交线索和查看个人上报记录。</text>

    <text class="muted" wx:if="{{error}}">{{error}}</text>

    <view class="demo-hint">
      <text class="muted demo-title">演示账号</text>
      <text class="muted">管理员：admin / admin123</text>
      <text class="muted">审核员：reviewer / review123</text>
      <text class="muted">普通用户：demo / demo123</text>
    </view>
  </view>
</view>
