.login-shell {
  display: flex;
  justify-content: center;
  padding-top: 80rpx;
}

.login-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 40rpx 36rpx;
}

.login-brand {
  display: block;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #305d3c;
}

.login-subtitle {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #6b786b;
  margin-bottom: 20rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 700;
}

.login-input {
  width: 100%;
  background: #f7f7f1;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}

.login-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 12rpx;
}

.login-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
}

.error-text {
  display: block;
  text-align: center;
  color: #c0392b;
  font-size: 26rpx;
}

.demo-hint {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ece8da;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.demo-title {
  font-weight: 700;
  margin-bottom: 4rpx;
}

/* --- WeChat login --- */
.wx-login-section {
  margin-top: 20rpx;
}

.divider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: var(--border);
}

.divider-text {
  font-size: 24rpx;
  color: var(--muted);
}

.wx-login-button {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  padding: 0;
  line-height: 88rpx;
}

.wx-login-button::after {
  border: none;
}

.wx-icon {
  font-size: 36rpx;
}
