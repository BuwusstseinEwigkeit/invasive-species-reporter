<view class="home-page-shell">
  <!-- 全页背景图：包含 Hero 设计和物种卡片 -->
  <image class="page-bg" src="/images/home-bg.png" mode="aspectFill" />

  <!-- 可滚动内容层 -->
  <view class="content-layer">

    <!-- Stats 叠加在背景图下方区域 -->
    <view class="card stats-card" wx:if="{{stats}}">
      <view class="section-header" hover-class="hover-tap" bindtap="toggleStats">
        <text class="section-title">当前概况</text>
        <view class="arrow {{statsCollapsed ? '' : 'arrow-down'}}"></view>
      </view>
      <view class="collapse-body {{statsCollapsed ? 'hidden' : ''}}">
        <view class="stats-grid">
          <view class="stats-item">
            <text class="stats-number">{{stats.totalReports}}</text>
            <text class="muted">累计上报</text>
          </view>
          <view class="stats-item">
            <text class="stats-number">{{stats.pendingReports}}</text>
            <text class="muted">待审核</text>
          </view>
          <view class="stats-item">
            <text class="stats-number">{{stats.approvedReports}}</text>
            <text class="muted">已核实</text>
          </view>
          <view class="stats-item">
            <text class="stats-number">{{stats.totalSpecies}}</text>
            <text class="muted">重点物种</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Species list -->
    <view class="species-section">
      <view class="section-header" hover-class="hover-tap" bindtap="toggleSpecies">
        <text class="section-title">重点物种（{{filteredSpecies.length}}）</text>
        <view class="arrow {{speciesCollapsed ? '' : 'arrow-down'}}"></view>
      </view>

      <!-- Category tabs -->
      <scroll-view scroll-x class="cat-tabs" wx:if="{{!speciesCollapsed}}">
        <view class="cat-tabs-inner">
          <view
            class="cat-tab {{activeCategory === '全部' ? 'cat-active' : ''}}"
            bindtap="setCategory"
            data-cat="全部"
          >全部</view>
          <view
            class="cat-tab {{activeCategory === '植物' ? 'cat-active' : ''}}"
            bindtap="setCategory"
            data-cat="植物"
          >植物</view>
          <view
            class="cat-tab {{activeCategory === '动物' ? 'cat-active' : ''}}"
            bindtap="setCategory"
            data-cat="动物"
          >动物</view>
          <view
            class="cat-tab {{activeCategory === '昆虫' ? 'cat-active' : ''}}"
            bindtap="setCategory"
            data-cat="昆虫"
          >昆虫</view>
          <view
            class="cat-tab {{activeCategory === '鱼类' ? 'cat-active' : ''}}"
            bindtap="setCategory"
            data-cat="鱼类"
          >鱼类</view>
          <view
            class="cat-tab {{activeCategory === '植物病害' ? 'cat-active' : ''}}"
            bindtap="setCategory"
            data-cat="植物病害"
          >植物病害</view>
        </view>
      </scroll-view>

      <scroll-view scroll-y enable-back-to-top class="species-scroll" wx:if="{{!speciesCollapsed}}">
        <view
          class="species-row"
          hover-class="hover-bg"
          wx:for="{{filteredSpecies}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openDetail"
        >
          <image
            wx:if="{{item.avatar}}"
            class="species-avatar"
            src="{{item.avatar}}"
            mode="aspectFill"
            data-id="{{item.id}}"
            bindtap="openDetail"
          />
          <view wx:else class="species-badge" data-id="{{item.id}}" bindtap="openDetail">{{item.category}}</view>
          <view class="species-copy" data-id="{{item.id}}" bindtap="openDetail">
            <text class="species-name">{{item.chineseName}}</text>
            <text class="muted">{{item.latinName}}</text>
            <text class="risk-line">风险等级：{{item.riskLevel}}</text>
          </view>
        </view>
        <view class="load-more-hint" wx:if="{{filteredSpecies.length >= species.length}}">
          <text class="muted">— 已加载全部 {{species.length}} 种重点物种 —</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
