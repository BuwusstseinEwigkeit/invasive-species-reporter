.hero {
  background: linear-gradient(145deg, #284d34, #88a56d);
  color: #ffffff;
  margin-bottom: 24rpx;
}

.hero-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-kicker {
  font-size: 22rpx;
  opacity: 0.84;
}

.version-chip {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-copy {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.8);
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-card,
.stats {
  margin-bottom: 24rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.quick-item {
  background: #eef4eb;
  border-radius: 20rpx;
  padding: 22rpx;
}

.quick-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: #264a31;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stats-item {
  background: #eef4eb;
  border-radius: 20rpx;
  padding: 20rpx;
}

.stats-number {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #305d3c;
}

.species-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e9ecdf;
}

.species-row:last-child {
  border-bottom: 0;
}

.species-badge,
.species-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.species-badge {
  background: #e7efe5;
  color: #305d3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.species-avatar {
  background: #e7efe5;
}

.species-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.species-name {
  font-size: 30rpx;
  font-weight: 700;
}

.risk-line {
  color: #305d3c;
  font-size: 25rpx;
}
