/* Home page: full-page background image + scrollable overlay content */
.home-page-shell {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.content-layer {
  position: relative;
  z-index: 1;
  height: 100vh;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}

/* Stats card: semi-transparent overlay on background image */
.stats-card {
  margin: 0 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stats-item {
  background: #eef4eb;
  border-radius: 20rpx;
  padding: 20rpx;
}

/* Species section */
.species-section {
  margin: 0 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 24rpx;
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  cursor: pointer;
  user-select: none;
  padding: 24rpx 0 16rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

/* Category tabs */
.cat-tabs {
  flex-shrink: 0;
  white-space: nowrap;
  height: 72rpx;
  margin-bottom: 12rpx;
}

.cat-tabs-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 4rpx;
  align-items: center;
  height: 72rpx;
}

.cat-tab {
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  height: 56rpx;
  background: #f0f4ed;
  color: #305d3c;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.cat-tab.cat-active {
  background: #305d3c;
  color: #ffffff;
  font-weight: 700;
}

/* Species scroll */
.species-scroll {
  height: 600rpx;
}

.species-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e9ecdf;
}

.species-row:last-child {
  border-bottom: 0;
}

.species-badge,
.species-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.species-badge {
  background: #e7efe5;
  color: #305d3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.species-avatar {
  background: #e7efe5;
}

.species-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.species-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2a1f;
}

.risk-line {
  color: #305d3c;
  font-size: 24rpx;
}

.load-more-hint {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
}

.stats-number {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #305d3c;
}
