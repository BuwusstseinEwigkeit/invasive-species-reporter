/* Home page: flex column fills viewport */
.home-page-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.hero {
  position: relative;
  background: linear-gradient(145deg, #1a3a2a, #4a7a5a);
  color: #ffffff;
  margin-bottom: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 24rpx;
}

.hero-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.6;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-chip {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.login-chip {
  background: rgba(255, 255, 255, 0.16) !important;
  color: #ffffff !important;
  border-radius: 999rpx !important;
  padding: 0 16rpx !important;
  font-size: 22rpx !important;
  line-height: 2.2 !important;
  min-height: 0 !important;
  border: none !important;
}

.logout-link {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  text-decoration: underline;
}

.hero-kicker {
  font-size: 22rpx;
  opacity: 0.84;
}

.version-chip {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.hero-copy {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.2);
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stats-card {
  flex-shrink: 0;
  margin-bottom: 16rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stats-item {
  background: #eef4eb;
  border-radius: 20rpx;
  padding: 20rpx;
}

.stats-number {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #305d3c;
}

/* Species section: fills remaining space with flex column */
.species-section {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  cursor: pointer;
  user-select: none;
}

.section-header .section-title {
  margin-bottom: 0;
}

/* Category tabs: horizontal scroll, fixed height */
.cat-tabs {
  flex-shrink: 0;
  white-space: nowrap;
  height: 72rpx;
  margin-bottom: 12rpx;
}

.cat-tabs-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 4rpx;
  align-items: center;
  height: 72rpx;
}

.cat-tab {
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  height: 56rpx;
  background: #f0f4ed;
  color: #305d3c;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.cat-tab.cat-active {
  background: #305d3c;
  color: #ffffff;
  font-weight: 700;
}

/* Species scroll: fills all remaining space */
.species-scroll {
  flex: 1;
  min-height: 0;
  height: 0; /* required for flex child to shrink below content size */
}

.species-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e9ecdf;
}

.species-row:last-child {
  border-bottom: 0;
}

.species-badge,
.species-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.species-badge {
  background: #e7efe5;
  color: #305d3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.species-avatar {
  background: #e7efe5;
}

.species-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.species-name {
  font-size: 30rpx;
  font-weight: 700;
}

.risk-line {
  color: #305d3c;
  font-size: 25rpx;
}

.load-more-hint {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
}
