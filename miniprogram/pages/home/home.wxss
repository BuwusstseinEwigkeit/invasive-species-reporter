/* Home page: page-shell provides padding, flex column fills screen */
.home-page-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* NO overflow:hidden — lets scroll-view handle its own scroll */
}

.hero {
  background: linear-gradient(145deg, #284d34, #88a56d);
  color: #ffffff;
  margin-bottom: 24rpx;
  /* Hero height is auto based on content */
  flex-shrink: 0;
}

.hero-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-chip {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.login-chip {
  background: rgba(255, 255, 255, 0.16) !important;
  color: #ffffff !important;
  border-radius: 999rpx !important;
  padding: 0 16rpx !important;
  font-size: 22rpx !important;
  line-height: 2.2 !important;
  min-height: 0 !important;
  border: none !important;
}

.logout-link {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  text-decoration: underline;
}

.hero-kicker {
  font-size: 22rpx;
  opacity: 0.84;
}

.version-chip {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-copy {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.8);
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* Stats card: auto height, flex-shrink prevents crushing */
.stats-card {
  flex-shrink: 0;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stats-item {
  background: #eef4eb;
  border-radius: 20rpx;
  padding: 20rpx;
}

.stats-number {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #305d3c;
}

/* Species scroll: JS-calculated height, flex-grow fills remaining */
.species-scroll {
  flex: 1;
  /* height set via JS: style="height: {{scrollHeight}}px" */
  min-height: 0; /* critical: allows flex child to shrink */
}

.species-card {
  /* card provides padding and shadow */
}

.species-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e9ecdf;
}

.species-row:last-child {
  border-bottom: 0;
}

.species-badge,
.species-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.species-badge {
  background: #e7efe5;
  color: #305d3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.species-avatar {
  background: #e7efe5;
}

.species-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.species-name {
  font-size: 30rpx;
  font-weight: 700;
}

.risk-line {
  color: #305d3c;
  font-size: 25rpx;
}
