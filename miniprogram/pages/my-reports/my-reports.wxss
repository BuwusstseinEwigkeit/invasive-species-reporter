.toolbar-card {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.search-input {
  width: 100%;
  background: #f7f7f1;
  border-radius: 18rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.filter-box {
  width: 100%;
  background: #f7f7f1;
  border-radius: 18rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #1f2a1f;
}

.loading-card {
  background: #fffdf7;
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  background: linear-gradient(90deg, #e8e8e0 25%, #f0efe8 50%, #e8e8e0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.w80 { width: 80%; }
.w60 { width: 60%; }
.w70 { width: 70%; }
.w50 { width: 50%; }

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-card {
  background: #fffdf7;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(52, 76, 52, 0.06);
}

.report-main {
  flex: 1;
  padding-right: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.report-ai {
  font-size: 30rpx;
  font-weight: 700;
}

.time {
  font-size: 22rpx;
}

.status-tag {
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 10rpx 16rpx;
  flex-shrink: 0;
}

.tag-approved {
  background: #e5f2e1;
  color: #305d3c;
}

.tag-pending {
  background: #f7f0d6;
  color: #b8860b;
}

.tag-rejected {
  background: #f5e6e6;
  color: #c0392b;
}
