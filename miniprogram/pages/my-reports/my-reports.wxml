<view class="page-shell">
  <view class="card toolbar-card">
    <input
      class="search-input"
      placeholder="搜索物种、地点或备注"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <picker range="{{statusOptions}}" value="{{selectedStatusIndex}}" bindchange="onStatusChange">
      <view class="filter-box">{{statusOptions[selectedStatusIndex]}}</view>
    </picker>
  </view>

  <view class="card empty-card" wx:if="{{!filteredReports.length}}">
    <text class="muted">没有匹配的上报记录。</text>
  </view>

  <view class="card report-card" wx:for="{{filteredReports}}" wx:key="id">
    <text class="report-title">{{item.aiTop1}}</text>
    <text class="muted">{{item.address}}</text>
    <text class="muted">{{item.createdAt}}</text>
    <text class="status-line">状态：{{item.status}}</text>
    <text class="muted" wx:if="{{item.aiScore}}">AI 置信度：{{item.aiScore}}</text>
    <image
      wx:if="{{item.imageUrl}}"
      class="report-image"
      src="{{item.imageUrl}}"
      mode="aspectFill"
      lazy-load
      data-url="{{item.imageUrl}}"
      bindtap="previewImage"
    />
  </view>
</view>
