<view class="page-shell">
  <!-- Header -->
  <view class="card leaderboard-header">
    <text class="section-title">排行榜</text>
    <text class="muted">看看谁是生态巡查高手</text>
  </view>

  <!-- Tab bar -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'weekly' ? 'active' : ''}}" data-tab="weekly" bindtap="switchTab">
      <text>周榜</text>
    </view>
    <view class="tab-item {{activeTab === 'total' ? 'active' : ''}}" data-tab="total" bindtap="switchTab">
      <text>总榜</text>
    </view>
    <view class="tab-item {{activeTab === 'newcomer' ? 'active' : ''}}" data-tab="newcomer" bindtap="switchTab">
      <text>新人榜</text>
    </view>
  </view>

  <view class="card leaderboard-header" wx:if="{{myRank}}">
    <text>我的当前排名：第 {{myRank}} 名</text>
    <text class="muted">{{myScore}} 积分</text>
  </view>

  <!-- Loading -->
  <view class="loading-card" wx:if="{{loading}}">
    <view class="skeleton-line w80"></view>
    <view class="skeleton-line w60"></view>
    <view class="skeleton-line w90"></view>
  </view>

  <view class="empty-state" wx:elif="{{loadError}}">
    <text class="empty-icon">⚠</text>
    <text class="muted">{{loadError}}</text>
    <button class="ghost-button" hover-class="hover-scale" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- Empty -->
  <view class="empty-state" wx:elif="{{activeListEmpty}}">
    <text class="empty-icon">🏆</text>
    <text class="muted">当前榜单暂无数据</text>
  </view>

  <!-- Weekly list -->
  <view class="rank-list" wx:elif="{{activeTab === 'weekly'}}">
    <view class="rank-card {{item.isMe ? 'active' : ''}}" wx:for="{{weeklyList}}" wx:key="userId">
      <view class="rank-left">
        <view class="rank-num {{item.rank <= 3 ? 'rank-top' : ''}}">{{item.rank <= 3 ? '' : item.rank}}</view>
        <view class="rank-avatar-wrap">
          <image class="rank-avatar" src="/images/avatar-placeholder.png" mode="aspectFill" />
        </view>
        <view class="rank-info">
          <text class="rank-username">{{item.username}}</text>
          <text class="muted rank-count">{{item.score}} 本周积分</text>
        </view>
      </view>
      <view wx:if="{{item.rank === 1}}" class="rank-medal">🥇</view>
      <view wx:elif="{{item.rank === 2}}" class="rank-medal">🥈</view>
      <view wx:elif="{{item.rank === 3}}" class="rank-medal">🥉</view>
    </view>
  </view>

  <!-- Total list -->
  <view class="rank-list" wx:elif="{{activeTab === 'total'}}">
    <view class="rank-card {{item.isMe ? 'active' : ''}}" wx:for="{{totalList}}" wx:key="userId">
      <view class="rank-left">
        <view class="rank-num {{item.rank <= 3 ? 'rank-top' : ''}}">{{item.rank <= 3 ? '' : item.rank}}</view>
        <view class="rank-avatar-wrap">
          <image class="rank-avatar" src="/images/avatar-placeholder.png" mode="aspectFill" />
        </view>
        <view class="rank-info">
          <text class="rank-username">{{item.username}}</text>
          <text class="muted rank-count">{{item.score}} 总积分</text>
        </view>
      </view>
      <view wx:if="{{item.rank === 1}}" class="rank-medal">🥇</view>
      <view wx:elif="{{item.rank === 2}}" class="rank-medal">🥈</view>
      <view wx:elif="{{item.rank === 3}}" class="rank-medal">🥉</view>
    </view>
  </view>

  <!-- Newcomer list -->
  <view class="rank-list" wx:elif="{{activeTab === 'newcomer'}}">
    <view class="rank-card {{item.isMe ? 'active' : ''}}" wx:for="{{newcomerList}}" wx:key="userId">
      <view class="rank-left">
        <view class="rank-num {{item.rank <= 3 ? 'rank-top' : ''}}">{{item.rank <= 3 ? '' : item.rank}}</view>
        <view class="rank-avatar-wrap">
          <image class="rank-avatar" src="/images/avatar-placeholder.png" mode="aspectFill" />
        </view>
        <view class="rank-info">
          <text class="rank-username">{{item.username}}</text>
          <text class="muted rank-count">{{item.score}} 总积分</text>
        </view>
      </view>
      <view wx:if="{{item.rank === 1}}" class="rank-medal">🥇</view>
      <view wx:elif="{{item.rank === 2}}" class="rank-medal">🥈</view>
      <view wx:elif="{{item.rank === 3}}" class="rank-medal">🥉</view>
    </view>
  </view>
</view>
