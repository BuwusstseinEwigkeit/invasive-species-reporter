.map-shell {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.map-area {
  width: 100%;
  height: 52vh;
}

.list-panel {
  flex: 1;
  background: #fffdf7;
  border-radius: 28rpx 28rpx 0 0;
  margin-top: -12rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  transition: flex 0.25s ease;
  display: flex;
  flex-direction: column;
}

.list-panel.collapsed {
  flex: 0 0 auto;
}

.panel-handle {
  display: flex;
  justify-content: center;
  padding: 6rpx 0 14rpx;
  cursor: pointer;
  user-select: none;
}

.handle-bar {
  width: 64rpx;
  height: 6rpx;
  background: #d4d8c8;
  border-radius: 999rpx;
}

.panel-header {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.panel-header-decor {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.15;
  border-radius: 16rpx;
}

.panel-header .section-title {
  position: relative;
  z-index: 1;
  margin-bottom: 0;
}

.panel-header .section-title {
  margin-bottom: 0;
}

.panel-toggle {
  padding: 8rpx;
  cursor: pointer;
  user-select: none;
}

.panel-body {
  overflow: hidden;
  transition: max-height 0.25s ease, opacity 0.2s ease;
  max-height: 2000rpx;
  opacity: 1;
}

.panel-body.hidden {
  max-height: 0;
  opacity: 0;
}

.filter-box {
  background: #f7f7f1;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  color: #1f2a1f;
}

.report-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  margin: 0 -8rpx;
  border-bottom: 1rpx solid #ece8da;
}

.report-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.status-tag {
  background: #e5f2e1;
  color: #305d3c;
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 10rpx 16rpx;
}

/* --- Heatmap toggle --- */
.map-overlay-buttons {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 10;
}

.heatmap-btn {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  cursor: pointer;
}

.heatmap-active {
  background: #305d3c;
}

.heatmap-btn-icon {
  font-size: 30rpx;
  line-height: 1;
}

.heatmap-btn-label {
  font-size: 20rpx;
  color: #666;
  line-height: 1;
  margin-top: 4rpx;
}

.heatmap-active .heatmap-btn-label {
  color: #fff;
}
