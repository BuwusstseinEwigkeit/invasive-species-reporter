.map-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.map-area {
  width: 100%;
  height: 52vh;
}

.list-panel {
  flex: 1;
  background: #fffdf7;
  border-radius: 28rpx 28rpx 0 0;
  margin-top: -12rpx;
  padding: 24rpx;
}

.filter-box {
  background: #f7f7f1;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  color: #1f2a1f;
}

.report-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ece8da;
}

.report-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.status-tag {
  background: #e5f2e1;
  color: #305d3c;
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 10rpx 16rpx;
}
