.detail-card,
.review-card {
  margin-bottom: 24rpx;
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.detail-head > view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-title {
  font-size: 38rpx;
  font-weight: 700;
}

.status-tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2e9;
  color: #305d3c;
  font-size: 24rpx;
}

.tag-rejected,
.tag-spam {
  background: #f6e7e3;
  color: #8b3328;
}

.tag-pending {
  background: #f5eed8;
  color: #7a6220;
}

.report-image {
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(31, 42, 31, 0.08);
}

.field-label {
  font-weight: 600;
}

.detail-value {
  color: #394739;
  word-break: break-all;
}

.candidate-list {
  margin-top: 24rpx;
}

.candidate-row,
.review-log {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
}

.review-log {
  flex-direction: column;
  border-bottom: 1rpx solid rgba(31, 42, 31, 0.08);
}

.review-action {
  font-weight: 700;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.detail-actions button {
  flex: 1;
}
