.review-header,
.review-card {
  margin-bottom: 24rpx;
}

.loading-card {
  background: #fffdf7;
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  background: linear-gradient(90deg, #e8e8e0 25%, #f0efe8 50%, #e8e8e0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.w80 { width: 80%; }
.w60 { width: 60%; }
.w70 { width: 70%; }

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.review-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.picker-wrap {
  margin-top: 18rpx;
}

.review-image {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  margin-top: 18rpx;
}

.candidate-wrap {
  margin-top: 18rpx;
}

.candidate-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  user-select: none;
}

.candidate-header .field-label {
  margin-bottom: 0;
}

.candidate-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.field-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.picker-box {
  background: #f7f7f1;
  border-radius: 18rpx;
  padding: 20rpx;
  color: #1f2a1f;
}

.review-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.modal-card {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fffdf7;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  z-index: 101;
}

.reject-input {
  width: 100%;
  min-height: 160rpx;
  background: #f7f7f1;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
