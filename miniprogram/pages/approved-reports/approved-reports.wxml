<view class="page-shell">

  <view class="toolbar-card">
    <input
      class="search-input"
      placeholder="搜索已核实物种、地点或备注"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <view class="loading-card" wx:if="{{loading}}">
    <view class="skeleton-line w80"></view>
    <view class="skeleton-line w60"></view>
    <view class="skeleton-line w70"></view>
  </view>

  <view wx:elif="{{!filteredReports.length}}" class="empty-state">
    <text class="empty-icon">✅</text>
    <text class="muted">暂无已核实记录</text>
  </view>

  <view class="report-list" wx:else>
    <view
      class="report-card"
      hover-class="hover-bg"
      wx:for="{{filteredReports}}"
      wx:key="id"
      data-id="{{item.speciesId}}"
      bindtap="openDetail"
    >
      <view class="report-main">
        <text class="report-ai">{{item.aiTop1 || "待审核"}}</text>
        <text class="muted">{{item.address || "未知位置"}}</text>
        <text class="muted time">{{item.createdAt}}</text>
      </view>
      <text class="status-tag">已核实</text>
    </view>
  </view>
</view>
