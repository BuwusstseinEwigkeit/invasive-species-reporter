.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx 28rpx;
  text-align: center;
}

.prompt-icon {
  font-size: 72rpx;
}

.prompt-desc {
  margin-bottom: 8rpx;
}

.login-prompt .primary-button {
  width: 60%;
  margin-top: 8rpx;
}

/* --- User card --- */

.user-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #284d34, #88a56d);
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.user-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
}

.user-avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #DAA520, #f0c040);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
}

.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 18rpx;
  text-align: center;
  padding: 4rpx 0;
  border-radius: 0 0 50% 50%;
  opacity: 0;
  transition: opacity 0.2s;
}

.user-avatar-wrap:active .avatar-edit-hint {
  opacity: 1;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
}

.user-role {
  font-size: 24rpx;
}

/* --- Badges --- */

.badges-card {
  margin-bottom: 24rpx;
}

.badges-row {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  justify-content: flex-start;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  min-width: 120rpx;
}

.badge-item.locked {
  opacity: 0.5;
}

.badge-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.badge-name {
  font-size: 22rpx;
  color: #305d3c;
  text-align: center;
  font-weight: 600;
}

.badge-progress {
  font-size: 18rpx;
  color: #888;
  text-align: center;
}

.user-edit {
  padding: 12rpx;
  font-size: 36rpx;
}

/* --- Points card --- */

.points-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 40rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(145deg, #284d34, #88a56d);
  color: #ffffff;
}

.points-number {
  font-size: 72rpx;
  font-weight: 700;
}

.points-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.points-actions {
  margin-top: 12rpx;
}

.points-actions .ghost-button {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: none;
}

/* --- Points log --- */

.log-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e9ecdf;
}

.log-row:last-child {
  border-bottom: 0;
}

.log-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.log-action {
  font-size: 28rpx;
}

.log-time {
  font-size: 22rpx;
}

.log-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.log-amount.positive {
  color: #305d3c;
}

.log-amount.negative {
  color: #c0392b;
}

/* --- Menu card --- */

.menu-card {
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  margin: 0 -8rpx;
  padding-left: 8rpx;
  padding-right: 8rpx;
  border-bottom: 1rpx solid #e9ecdf;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-icon {
  font-size: 36rpx;
  width: 44rpx;
  text-align: center;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
}

.badge {
  background: #c0392b;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-right: 8rpx;
}

.menu-arrow {
  color: #b8c2b0;
  font-size: 36rpx;
}

.logout-card {
  margin-bottom: 48rpx;
}

.logout-text {
  color: #c0392b;
}
