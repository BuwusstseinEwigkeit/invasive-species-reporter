{
  "name": "invasive-species-reporter",
  "version": "0.8.0",
  "private": true,
  "description": "外来物种上报、识别、审核与积分闭环微信小程序。",
  "scripts": {
    "start": "node server/index.js",
    "test": "jest --runInBand --forceExit",
    "test:ci": "jest --runInBand",
    "check:js": "find server miniprogram -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check": "npm run check:js && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
